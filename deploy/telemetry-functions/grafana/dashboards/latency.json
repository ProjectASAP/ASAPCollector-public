{
  "uid": "asap-latency",
  "title": "Latency quantiles: sketch vs exact (real collector containers)",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "route",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "asap-prometheus"
        },
        "query": {
          "query": "label_values(asap_quantile, http_route)",
          "refId": "route"
        },
        "refresh": 2,
        "current": {
          "text": "http.route-0",
          "value": "http.route-0"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "p99 latency for $route: sketch with bound vs exact",
      "datasource": {
        "type": "prometheus",
        "uid": "asap-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "asap_quantile{quantile=\"0.99\",http_route=\"$route\",method=\"sketch\",bound=\"estimate\"}",
          "legendFormat": "sketch"
        },
        {
          "refId": "B",
          "expr": "asap_quantile{quantile=\"0.99\",http_route=\"$route\",method=\"sketch\",bound=\"lower\"}",
          "legendFormat": "sketch lower"
        },
        {
          "refId": "C",
          "expr": "asap_quantile{quantile=\"0.99\",http_route=\"$route\",method=\"sketch\",bound=\"upper\"}",
          "legendFormat": "sketch upper"
        },
        {
          "refId": "D",
          "expr": "asap_quantile{quantile=\"0.99\",http_route=\"$route\",method=\"exact\"}",
          "legendFormat": "exact"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "spanNulls": true
          },
          "unit": "ms"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "sketch upper"
            },
            "properties": [
              {
                "id": "custom.fillBelowTo",
                "value": "sketch lower"
              },
              {
                "id": "custom.lineWidth",
                "value": 0
              },
              {
                "id": "custom.fillOpacity",
                "value": 20
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "sketch lower"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "sketch"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "exact"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    4
                  ]
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "p50 latency for $route: sketch with bound vs exact",
      "datasource": {
        "type": "prometheus",
        "uid": "asap-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "asap_quantile{quantile=\"0.5\",http_route=\"$route\",method=\"sketch\",bound=\"estimate\"}",
          "legendFormat": "sketch"
        },
        {
          "refId": "B",
          "expr": "asap_quantile{quantile=\"0.5\",http_route=\"$route\",method=\"sketch\",bound=\"lower\"}",
          "legendFormat": "sketch lower"
        },
        {
          "refId": "C",
          "expr": "asap_quantile{quantile=\"0.5\",http_route=\"$route\",method=\"sketch\",bound=\"upper\"}",
          "legendFormat": "sketch upper"
        },
        {
          "refId": "D",
          "expr": "asap_quantile{quantile=\"0.5\",http_route=\"$route\",method=\"exact\"}",
          "legendFormat": "exact"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "spanNulls": true
          },
          "unit": "ms"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "sketch upper"
            },
            "properties": [
              {
                "id": "custom.fillBelowTo",
                "value": "sketch lower"
              },
              {
                "id": "custom.lineWidth",
                "value": 0
              },
              {
                "id": "custom.fillOpacity",
                "value": 20
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "sketch lower"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "sketch"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "exact"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    4
                  ]
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Relative error of the sketch p99 vs exact (routes with > 20,000 points per window)",
      "datasource": {
        "type": "prometheus",
        "uid": "asap-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "abs(asap_quantile{quantile=\"0.99\",method=\"sketch\",bound=\"estimate\"} - on(http_route) asap_quantile{quantile=\"0.99\",method=\"exact\"}) / on(http_route) asap_quantile{quantile=\"0.99\",method=\"exact\"} and on(http_route) asap_points{method=\"exact\"} > 20000",
          "legendFormat": "{{http_route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "spanNulls": true
          },
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "CPU cores per pinned stage",
      "datasource": {
        "type": "prometheus",
        "uid": "asap-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stage) (rate(cpu_time_total{job=\"collectors\",otel_scope_pipeline_id=\"main\"}[1m]))",
          "legendFormat": "{{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "spanNulls": true
          },
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Bytes received per stage, log scale (sketches at merge, raw points at exact)",
      "datasource": {
        "type": "prometheus",
        "uid": "asap-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stage) (rate(payload_size_bytes_total{job=\"collectors\",otel_scope_node_type=\"receiver\"}[1m])) * 8",
          "legendFormat": "{{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "spanNulls": true,
            "scaleDistribution": {
              "type": "log",
              "log": 10
            }
          },
          "unit": "bps"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Resident memory per stage",
      "datasource": {
        "type": "prometheus",
        "uid": "asap-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (stage) (memory_rss{job=\"collectors\"})",
          "legendFormat": "{{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "spanNulls": true
          },
          "unit": "bytes"
        },
        "overrides": []
      }
    }
  ]
}
