    {
      "id": 4,
      "type": "timeseries",
      "title": "Relative error of the sketch p99 vs exact (routes with > 20,000 points per window)",
      "datasource": {
        "type": "prometheus",
        "uid": "asap-prometheus-latency"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "targets": [
        {
          "refId": "A",
          "expr": "abs(asap_quantile{quantile=\"0.99\",method=\"sketch\",bound=\"estimate\"} - on(http_route) asap_quantile{quantile=\"0.99\",method=\"exact\"}) / on(http_route) asap_quantile{quantile=\"0.99\",method=\"exact\"} and on(http_route) asap_points{method=\"exact\"} > 20000",
          "legendFormat": "{{http_route}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "spanNulls": true
          },
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "id": 9,
      "title": "Throughput per pipeline: points per second each window delivered to the end of its pipeline",
      "description": "Points in each 1-minute window that reached the end of the pipeline, divided by 60 s: for sketch and exact the points their detector answered for, for raw the points loki-raw acknowledged within 50 s of the window's end. Offered: 2 sources x 20,000 points/s. A pipeline below the offered line is dropping or falling behind.",
      "datasource": {
        "type": "prometheus",
        "uid": "asap-prometheus-latency"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (method) (last_over_time(asap_points{method=~\"sketch|exact\",attribute_key=\"\"}[2m])) / 60",
          "legendFormat": "{{method}}"
        },
        {
          "refId": "B",
          "expr": "sum by (method) (last_over_time(asap_points{method=\"raw\"}[2m])) / 60",
          "legendFormat": "{{method}}"
        },
        {
          "refId": "C",
          "expr": "vector(40000)",
          "legendFormat": "offered"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {
            "spanNulls": true,
            "showPoints": "always",
            "pointSize": 6
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "offered"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    4
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8e8e8e"
                }
              },
              {
                "id": "custom.showPoints",
                "value": "never"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Window completion delay: seconds from a window's end until its result is complete",
