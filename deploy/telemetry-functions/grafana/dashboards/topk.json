    {
      "type": "row",
      "title": "From data generated to query result (p50 over a window's points, latest window)",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 35
      },
      "id": 10
