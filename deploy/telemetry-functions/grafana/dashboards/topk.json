        {
          "refId": "B",
          "expr": "sum by (method) (asap_points{method=\"raw\"}) / 60",
          "legendFormat": "{{method}}"
        },
        {
          "refId": "C",
          "expr": "vector(40000)",
          "legendFormat": "offered"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "min": 0,
          "custom": {
            "spanNulls": true,
            "showPoints": "always",
            "pointSize": 6
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "offered"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    4
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8e8e8e"
