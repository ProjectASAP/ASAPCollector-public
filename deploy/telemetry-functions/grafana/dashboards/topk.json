    {
      "type": "barchart",
      "title": "Data generated -> query result: where the time goes",
      "datasource": {
        "type": "prometheus",
        "uid": "asap-prometheus-topk"
      },
      "description": "Per approach, p50 over the window's points (p99 adds 29.4 s of window wait). 1. Every point waits for its 1-minute window to end (30 s at p50, the same for all three). 2. After the window's end until the window's data is queryable: sketch and exact until the detector wrote the answer to their Prometheus; store and query until prometheus-raw acknowledged the window's last raw point. 3. The query that returns the window's answer on the approach's own Prometheus: sketch and exact read the stored answer (estimates only); store and query computes it from every raw sample (one PromQL top-k query).",
      "targets": [
        {
          "refId": "A",
          "expr": "label_replace(label_replace(0 * max by (method) (last_over_time(asap_query_seconds[5m])) + 30, \"approach\", \"$1\", \"method\", \"(.*)\"), \"approach\", \"store and query\", \"method\", \"raw\")",
          "format": "table",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "label_replace(label_replace(max by (method) (last_over_time(asap_data_available_seconds{quantile=\"0.5\"}[5m])) - 30, \"approach\", \"$1\", \"method\", \"(.*)\"), \"approach\", \"store and query\", \"method\", \"raw\")",
          "format": "table",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "label_replace(label_replace(max by (method) (last_over_time(asap_query_seconds[5m])), \"approach\", \"$1\", \"method\", \"(.*)\"), \"approach\", \"store and query\", \"method\", \"raw\")",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "approach",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "approach": true,
              "Value #A": true,
              "Value #B": true,
              "Value #C": true
            },
            "indexByName": {
              "approach": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3
            },
            "renameByName": {
              "Value #A": "wait for the window to end",
              "Value #B": "after the window's end until data is queryable",
              "Value #C": "query"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "approach"
              }
            ]
          }
        }
      ],
      "options": {
        "orientation": "horizontal",
        "stacking": "normal",
        "xField": "approach",
        "showValue": "always",
        "barWidth": 0.6,
        "groupWidth": 0.7,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "min": 0,
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0
