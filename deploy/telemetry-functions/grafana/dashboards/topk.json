    {
      "type": "timeseries",
      "title": "Heavy hitters (routes with >= 1% of the window's points): sketch vs exact, per window",
      "datasource": {
        "type": "prometheus",
        "uid": "asap-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "refId": "A",
          "expr": "asap_hh_precision",
          "legendFormat": "precision"
        },
        {
          "refId": "B",
          "expr": "asap_hh_recall",
          "legendFormat": "recall"
        },
        {
          "refId": "C",
          "expr": "asap_hh_f1",
          "legendFormat": "F1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1.05,
          "decimals": 2,
          "custom": {
            "spanNulls": true,
            "drawStyle": "line",
            "pointSize": 6,
            "showPoints": "always"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      },
      "id": 10,
      "description": "Precision = reported heavy hitters that are real / all reported (low: Count-Min overestimates push small routes over the threshold). Recall = real heavy hitters the sketch reported / all real ones (low: the heap dropped one). A heavy hitter has at least 1% of the window's points by the exact counts; the sketch reports a route when its estimate reaches 1%."
    },
    {
      "type": "timeseries",
      "title": "Average relative count error of the heavy hitters found (ARE)",
      "datasource": {
        "type": "prometheus",
        "uid": "asap-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
