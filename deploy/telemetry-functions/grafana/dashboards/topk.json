    {
      "type": "timeseries",
      "title": "End-to-end throughput: points per second each window delivered to the end of its pipeline",
      "datasource": {
        "type": "prometheus",
        "uid": "asap-prometheus"
      },
      "description": "Both sources together. The generators skip batches a pipeline cannot take, so a pipeline that falls behind delivers less. Store and query: points loki-raw acknowledged within 50 s of the window's end. A pipeline that stops reporting shows a gap after 2 minutes.",
