    {
      "type": "table",
      "title": "Top-10 routes of the three approaches, latest window store and query answered (union of their top-10s)",
      "description": "One row per route in any approach's top-10, all from the latest window store and query has answered (query-job republishes sketch and exact for it), which lags behind when the log store is slow; the panel on the right shows which window. Error is (count - exact) / exact; empty when the route is outside that approach's reported top-20.",
      "datasource": {
        "type": "prometheus",
        "uid": "asap-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (key, exact_rank) (label_replace(asap_compare_topk{method=\"exact\",rank=~\"[1-9]|10\"}, \"exact_rank\", \"$1\", \"rank\", \"(.*)\"))",
          "format": "table",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "max by (key, sketch_rank) (label_replace(asap_compare_topk{method=\"sketch\",rank=~\"[1-9]|10\"}, \"sketch_rank\", \"$1\", \"rank\", \"(.*)\"))",
          "format": "table",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "max by (key, raw_rank) (label_replace(asap_compare_topk{method=\"raw\",rank=~\"[1-9]|10\"}, \"raw_rank\", \"$1\", \"rank\", \"(.*)\"))",
          "format": "table",
          "instant": true
        },
        {
          "refId": "D",
          "expr": "100 * (max by (key) (asap_compare_topk{method=\"sketch\"}) - on (key) max by (key) (asap_compare_topk{method=\"exact\"})) / on (key) max by (key) (asap_compare_topk{method=\"exact\"}) and on (key) (max by (key, exact_rank) (label_replace(asap_compare_topk{method=\"exact\",rank=~\"[1-9]|10\"}, \"exact_rank\", \"$1\", \"rank\", \"(.*)\")) or max by (key, sketch_rank) (label_replace(asap_compare_topk{method=\"sketch\",rank=~\"[1-9]|10\"}, \"sketch_rank\", \"$1\", \"rank\", \"(.*)\")) or max by (key, raw_rank) (label_replace(asap_compare_topk{method=\"raw\",rank=~\"[1-9]|10\"}, \"raw_rank\", \"$1\", \"rank\", \"(.*)\")))",
          "format": "table",
          "instant": true
        },
        {
          "refId": "E",
          "expr": "100 * (max by (key) (asap_compare_topk{method=\"raw\"}) - on (key) max by (key) (asap_compare_topk{method=\"exact\"})) / on (key) max by (key) (asap_compare_topk{method=\"exact\"}) and on (key) (max by (key, exact_rank) (label_replace(asap_compare_topk{method=\"exact\",rank=~\"[1-9]|10\"}, \"exact_rank\", \"$1\", \"rank\", \"(.*)\")) or max by (key, sketch_rank) (label_replace(asap_compare_topk{method=\"sketch\",rank=~\"[1-9]|10\"}, \"sketch_rank\", \"$1\", \"rank\", \"(.*)\")) or max by (key, raw_rank) (label_replace(asap_compare_topk{method=\"raw\",rank=~\"[1-9]|10\"}, \"raw_rank\", \"$1\", \"rank\", \"(.*)\")))",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "key",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true
            },
            "indexByName": {
              "key": 0,
              "exact_rank": 1,
              "Value #A": 2,
              "sketch_rank": 3,
              "Value #B": 4,
              "Value #D": 5,
              "raw_rank": 6,
              "Value #C": 7,
              "Value #E": 8
            },
            "renameByName": {
              "key": "Route",
              "exact_rank": "Exact rank",
              "Value #A": "Exact count",
              "sketch_rank": "Sketch rank",
              "Value #B": "Sketch count",
              "Value #D": "Sketch error",
              "raw_rank": "Store+query rank",
              "Value #C": "Store+query count",
              "Value #E": "Store+query error"
            }
          }
        },
        {
          "id": "convertFieldType",
          "options": {
            "conversions": [
              {
                "targetField": "Exact rank",
                "destinationType": "number"
              },
              {
                "targetField": "Sketch rank",
                "destinationType": "number"
              },
              {
                "targetField": "Store+query rank",
                "destinationType": "number"
              }
            ]
          }
        }
      ],
      "options": {
