    {
      "type": "timeseries",
      "title": "Time after the 5-minute range ends until the answer, over time (log scale)",
      "datasource": {
        "type": "prometheus",
        "uid": "asap-prometheus-topk"
      },
      "description": "Every approach answers over the last 5 minutes, once a minute. Data generated -> query result, minus the 5-minute wait for the range to end: that wait is the same for all three approaches, so it is subtracted. What is left: until the data is queryable (Sketch and Exact: the detector wrote the answer to their Prometheus; Raw: prometheus-raw acknowledged the range's last point), plus the query on the approach's own Prometheus (Sketch and Exact read the stored answer; Raw computes it from every raw sample: one PromQL top-k query). Log scale: the values go from milliseconds to minutes.",
      "targets": [
        {
          "refId": "A",
          "expr": "max(asap_result_age_seconds{method=\"sketch\"} - asap_window_wait_seconds{method=\"sketch\"})",
          "legendFormat": "Sketch"
