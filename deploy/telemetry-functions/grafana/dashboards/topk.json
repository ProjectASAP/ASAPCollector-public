          "legendFormat": "heavy hitters (exact)"
        },
        {
          "refId": "C",
          "expr": "asap_hh_reported",
          "legendFormat": "reported (sketch)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "spanNulls": true,
            "showPoints": "always",
            "pointSize": 6
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "ARE"
            },
            "properties": [
              {
                "id": "unit",
