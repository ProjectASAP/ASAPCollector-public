    {
      "type": "gauge",
      "title": "Sketch heavy hitters (clients with >= 1% of the requests), last 5 minutes",
      "datasource": {
        "type": "prometheus",
        "uid": "asap-prometheus-topk"
      },
      "description": "Sketch against exact. Truth: exact counts >= 1% of the window's points.",
      "targets": [
        {
          "refId": "A",
          "expr": "last_over_time(asap_hh_precision{method=\"sketch\"}[5m])",
          "legendFormat": "precision",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "last_over_time(asap_hh_recall{method=\"sketch\"}[5m])",
          "legendFormat": "recall",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "last_over_time(asap_hh_f1{method=\"sketch\"}[5m])",
          "legendFormat": "F1",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "green",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 16,
        "x": 0,
        "y": 11
      },
      "id": 3
    },
