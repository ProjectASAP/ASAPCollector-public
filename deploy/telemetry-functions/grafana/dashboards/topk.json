    {
      "type": "timeseries",
      "title": "Count of /new/hot-route per minute: sketch with Count-Min bound vs exact",
      "datasource": {
        "type": "prometheus",
        "uid": "asap-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
