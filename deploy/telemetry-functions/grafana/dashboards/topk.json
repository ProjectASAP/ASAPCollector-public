    {
      "type": "timeseries",
      "title": "2. Query latency (the query that returns the window's answer)",
      "datasource": {
        "type": "prometheus",
        "uid": "asap-prometheus-topk"
      },
      "description": "Measured by query-job once per window against each approach's own Prometheus. sketch and exact read the stored answer (estimates only, so both read the same series); store and query computes it from every raw sample (one PromQL top-k query). Includes refused and timed-out queries.",
      "targets": [
        {
          "refId": "A",
          "expr": "max(asap_query_seconds{method=\"sketch\"})",
          "legendFormat": "sketch"
        },
        {
          "refId": "B",
          "expr": "max(asap_query_seconds{method=\"exact\"})",
          "legendFormat": "exact"
        },
        {
          "refId": "C",
          "expr": "max(asap_query_seconds{method=\"raw\"})",
          "legendFormat": "store and query"
        }
