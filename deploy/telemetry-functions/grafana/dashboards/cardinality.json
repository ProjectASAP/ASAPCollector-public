    {
      "type": "gauge",
      "title": "Sketch (HLL): relative error of the distinct count per key, latest window compared",
      "datasource": {
        "type": "prometheus",
        "uid": "asap-prometheus-cardinality"
      },
      "description": "|estimate - exact| / exact; empty when the latest windows' points differ by more than 1% (a source missed a merge) or exact has no answer.",
      "targets": [
        {
          "refId": "A",
          "expr": "(abs(max by (attribute_key) (asap_distinct{method=\"sketch\",bound=\"estimate\"}) - on (attribute_key) max by (attribute_key) (asap_distinct{method=\"exact\"})) / on (attribute_key) max by (attribute_key) (asap_distinct{method=\"exact\"})) and on (attribute_key) (max by (attribute_key) (timestamp(asap_distinct{method=\"sketch\"})) == on (attribute_key) max by (attribute_key) (timestamp(asap_distinct{method=\"exact\"}))) and on () (abs(max(asap_points{method=\"sketch\",attribute_key=\"http.route\"}) - max(asap_points{method=\"exact\",attribute_key=\"http.route\"})) <= 0.01 * max(asap_points{method=\"sketch\",attribute_key=\"http.route\"}))",
          "legendFormat": "{{attribute_key}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 0.1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.02
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "id": 9
    },
    {
      "type": "row",
      "title": "From data generated to query result (p50 over a window's points, latest window)",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 39
      },
      "id": 10
    },
    {
      "type": "barchart",
      "title": "Data generated -> query result: where the time goes",
      "datasource": {
        "type": "prometheus",
        "uid": "asap-prometheus-cardinality"
      },
      "description": "Per approach, p50 over the window's points. 1. sketch and exact compute per 1-minute window, so a point waits for its window to end (30 s at p50, 59.4 s at p99); store and query has no window. 2. Then until the data is queryable: sketch and exact until the detector wrote the window's answer to their Prometheus; store and query until prometheus-raw acknowledged the point (otlp-forwarder forwards each point as it arrives). 3. The query that returns the window's answer on the approach's own Prometheus: sketch and exact read the stored answer (estimates only); store and query computes it from every raw sample (one PromQL distinct count per key, summed).",
      "targets": [
        {
          "refId": "A",
          "expr": "label_replace(label_replace(max by (method) (last_over_time(asap_window_wait_seconds{quantile=\"0.5\"}[5m])), \"approach\", \"$1\", \"method\", \"(.*)\"), \"approach\", \"store and query\", \"method\", \"raw\")",
          "format": "table",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "label_replace(label_replace(max by (method) (last_over_time(asap_data_available_seconds{quantile=\"0.5\"}[5m])) - on (method) max by (method) (last_over_time(asap_window_wait_seconds{quantile=\"0.5\"}[5m])), \"approach\", \"$1\", \"method\", \"(.*)\"), \"approach\", \"store and query\", \"method\", \"raw\")",
          "format": "table",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "label_replace(label_replace(max by (method) (last_over_time(asap_query_seconds[5m])), \"approach\", \"$1\", \"method\", \"(.*)\"), \"approach\", \"store and query\", \"method\", \"raw\")",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "approach",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "includeByName": {
              "approach": true,
              "Value #A": true,
              "Value #B": true,
              "Value #C": true
            },
            "indexByName": {
              "approach": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3
            },
            "renameByName": {
              "Value #A": "wait for the window to end",
              "Value #B": "then until data is queryable",
              "Value #C": "query"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "approach"
