    {
      "type": "table",
      "title": "Distinct values per attribute key, latest window Raw answered",
      "description": "All from the latest window Raw has answered (query-job republishes sketch and exact for it), which lags behind when prometheus-raw is slow; the panel on the right shows which window. Error is (count - exact) / exact; when one method's window holds more than 1% fewer points than the other's (a source missed its merge), that method's count and class are left empty, and so are the errors that compare with it. Class: the detector's verdict from the last 10 windows (stable, growing, identifier-like). Raw refused because: why prometheus-raw refused, timed out or returned nothing for the key's PromQL query, which leaves its count empty.",
      "datasource": {
        "type": "prometheus",
        "uid": "asap-prometheus-cardinality"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (attribute_key) (asap_compare_distinct{method=\"exact\"})",
          "format": "table",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "max by (attribute_key) (asap_compare_distinct{method=\"sketch\"})",
          "format": "table",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "max by (attribute_key) (asap_compare_distinct{method=\"raw\"})",
          "format": "table",
          "instant": true
        },
        {
          "refId": "D",
          "expr": "100 * (max by (attribute_key) (asap_compare_distinct{method=\"sketch\"}) - on (attribute_key) max by (attribute_key) (asap_compare_distinct{method=\"exact\"})) / on (attribute_key) max by (attribute_key) (asap_compare_distinct{method=\"exact\"})",
          "format": "table",
          "instant": true
        },
        {
          "refId": "E",
          "expr": "100 * (max by (attribute_key) (asap_compare_distinct{method=\"raw\"}) - on (attribute_key) max by (attribute_key) (asap_compare_distinct{method=\"exact\"})) / on (attribute_key) max by (attribute_key) (asap_compare_distinct{method=\"exact\"})",
          "format": "table",
          "instant": true
        },
        {
          "refId": "F",
          "expr": "max by (attribute_key, exact_class) (label_replace(asap_compare_class{method=\"exact\"}, \"exact_class\", \"$1\", \"state\", \"(.*)\"))",
          "format": "table",
          "instant": true
        },
        {
          "refId": "G",
          "expr": "max by (attribute_key, sketch_class) (label_replace(asap_compare_class{method=\"sketch\"}, \"sketch_class\", \"$1\", \"state\", \"(.*)\"))",
          "format": "table",
          "instant": true
        },
        {
          "refId": "H",
          "expr": "max by (attribute_key, reason) (asap_compare_failed)",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "attribute_key",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #F": true,
              "Value #G": true,
              "Value #H": true,
              "Time 1": true,
              "Time 2": true,
              "Time 3": true,
              "Time 4": true,
              "Time 5": true,
              "Time 6": true,
              "Time 7": true,
              "Time 8": true
            },
            "indexByName": {
              "attribute_key": 0,
              "Value #A": 1,
              "exact_class": 2,
              "Value #B": 3,
              "Value #D": 4,
              "sketch_class": 5,
              "Value #C": 6,
              "Value #E": 7,
              "reason": 8
            },
            "renameByName": {
              "attribute_key": "Attribute key",
              "Value #A": "Exact distinct",
              "exact_class": "Exact class",
              "Value #B": "Sketch estimate",
              "Value #D": "Sketch error",
              "sketch_class": "Sketch class",
              "Value #C": "Raw",
              "Value #E": "Raw error",
              "reason": "Raw refused because"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Exact distinct",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
