          "expr": "(sum(rate(payload_size_bytes_total{job=\"collectors\",stage=~\"branch-.|merge|detector\",otel_scope_node_type=\"receiver\"}[2m])) * 8 or vector(0))",
          "legendFormat": "Sketch",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "(sum(rate(payload_size_bytes_total{job=\"collectors\",stage=~\"exact-branch-.|exact-merge|exact-detector\",otel_scope_node_type=\"receiver\"}[2m])) * 8 or vector(0))",
