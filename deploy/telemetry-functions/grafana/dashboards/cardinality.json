                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#5794f2"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Exact"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#ff9830"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Raw"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8e8e8e"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 33
      },
      "id": 9
    },
    {
      "type": "bargauge",
      "title": "Memory: whole approach",
      "datasource": {
        "type": "prometheus",
        "uid": "asap-prometheus-cardinality"
      },
      "description": "Resident memory of every component of the approach, its Prometheus included.",
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(max by (stage) (memory_rss{job=\"collectors\",stage=~\"branch-.|merge|detector\"})) or vector(0)) + (sum(max by (stage) (process_resident_memory_bytes{stage=~\"prometheus-sketch\"})) or vector(0))",
          "legendFormat": "Sketch",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "(sum(max by (stage) (memory_rss{job=\"collectors\",stage=~\"exact-branch-.|exact-merge|exact-detector\"})) or vector(0)) + (sum(max by (stage) (process_resident_memory_bytes{stage=~\"prometheus-exact\"})) or vector(0))",
          "legendFormat": "Exact",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "(sum(max by (stage) (memory_rss{job=\"collectors\",stage=~\"raw-sink-.\"})) or vector(0)) + (sum(max by (stage) (process_resident_memory_bytes{stage=~\"prometheus-raw|query-job\"})) or vector(0))",
          "legendFormat": "Raw",
          "instant": true
