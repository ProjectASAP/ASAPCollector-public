{
  "uid": "asap-cardinality",
  "title": "Attribute cardinality: sketch vs exact (real collector containers)",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "attribute",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "asap-prometheus"
        },
        "query": {
          "query": "label_values(asap_distinct, attribute_key)",
          "refId": "attribute"
        },
        "refresh": 2,
        "current": {
          "text": "k8s.pod.name",
          "value": "k8s.pod.name"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Distinct values of $attribute per minute: sketch with 95% bound vs exact",
      "datasource": {
        "type": "prometheus",
        "uid": "asap-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "asap_distinct{attribute_key=\"$attribute\",method=\"sketch\",bound=\"estimate\"}",
          "legendFormat": "sketch"
        },
        {
          "refId": "B",
          "expr": "asap_distinct{attribute_key=\"$attribute\",method=\"sketch\",bound=\"lower\"}",
          "legendFormat": "sketch lower"
        },
        {
          "refId": "C",
          "expr": "asap_distinct{attribute_key=\"$attribute\",method=\"sketch\",bound=\"upper\"}",
          "legendFormat": "sketch upper"
        },
        {
          "refId": "D",
          "expr": "asap_distinct{attribute_key=\"$attribute\",method=\"exact\"}",
          "legendFormat": "exact"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "spanNulls": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "sketch upper"
            },
            "properties": [
              {
                "id": "custom.fillBelowTo",
                "value": "sketch lower"
              },
              {
                "id": "custom.lineWidth",
                "value": 0
              },
              {
                "id": "custom.fillOpacity",
                "value": 20
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "sketch lower"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "sketch"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "exact"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    6,
                    4
                  ]
                }
              }
            ]
          }
        ]
      },
      "id": 1
    },
    {
      "type": "table",
      "title": "Class of every attribute key (latest window)",
      "datasource": {
        "type": "prometheus",
        "uid": "asap-prometheus"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "asap_cardinality_state == 1",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "metric": true
            },
            "renameByName": {
              "attribute_key": "attribute",
              "method": "method",
              "state": "class"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "class",
                "desc": false
              },
              {
                "field": "attribute"
              }
            ]
          }
        }
      ],
      "id": 2
    },
    {
      "type": "timeseries",
      "title": "Distinct / points per attribute key (1.0 = every point new)",
      "datasource": {
        "type": "prometheus",
        "uid": "asap-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "asap_distinct_ratio",
          "legendFormat": "{{attribute_key}} {{method}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "max": 1,
          "min": 0
        },
        "overrides": []
      },
      "id": 3
    },
    {
      "type": "logs",
      "title": "Cardinality events (Loki)",
      "datasource": {
        "type": "loki",
        "uid": "asap-loki"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"asap-detector\"} | event_kind=\"cardinality\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "id": 4
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "CPU cores per pinned stage",
      "datasource": {
        "type": "prometheus",
        "uid": "asap-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stage) (rate(cpu_time_total{job=\"collectors\",otel_scope_pipeline_id=\"main\"}[1m]))",
          "legendFormat": "{{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "spanNulls": true
          },
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Bytes received per stage, log scale (sketches at merge, raw points at exact)",
      "datasource": {
        "type": "prometheus",
        "uid": "asap-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 20
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (stage) (rate(payload_size_bytes_total{job=\"collectors\",otel_scope_node_type=\"receiver\"}[1m])) * 8",
          "legendFormat": "{{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "spanNulls": true,
            "scaleDistribution": {
              "type": "log",
              "log": 10
            }
          },
          "unit": "bps"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Resident memory per stage",
      "datasource": {
        "type": "prometheus",
        "uid": "asap-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 20
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (stage) (memory_rss{job=\"collectors\"})",
          "legendFormat": "{{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "spanNulls": true
          },
          "unit": "bytes"
        },
        "overrides": []
      }
    }
  ]
}
