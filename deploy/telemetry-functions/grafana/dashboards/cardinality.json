    {
      "type": "timeseries",
      "title": "1. Delay before data is available for query (data generated -> available)",
      "datasource": {
        "type": "prometheus",
        "uid": "asap-prometheus-cardinality"
      },
      "description": "Per point, p50 and p99 over the window's points: from its generation until its window's data can be queried. Every point first waits for its window to end (up to 60 s). sketch and exact: then until the detector sent the window's answer to its Prometheus. store and query: then until prometheus-raw acknowledged the window's last raw point.",
      "targets": [
        {
          "refId": "A",
          "expr": "max(asap_data_available_seconds{method=\"sketch\",quantile=\"0.5\"})",
          "legendFormat": "sketch p50"
        },
        {
          "refId": "B",
          "expr": "max(asap_data_available_seconds{method=\"sketch\",quantile=\"0.99\"})",
          "legendFormat": "sketch p99"
        },
        {
          "refId": "C",
          "expr": "max(asap_data_available_seconds{method=\"exact\",quantile=\"0.5\"})",
          "legendFormat": "exact p50"
        },
        {
          "refId": "D",
          "expr": "max(asap_data_available_seconds{method=\"exact\",quantile=\"0.99\"})",
          "legendFormat": "exact p99"
        },
        {
          "refId": "E",
          "expr": "max(asap_data_available_seconds{method=\"raw\",quantile=\"0.5\"})",
          "legendFormat": "store and query p50"
        },
        {
          "refId": "F",
          "expr": "max(asap_data_available_seconds{method=\"raw\",quantile=\"0.99\"})",
          "legendFormat": "store and query p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "spanNulls": true,
            "scaleDistribution": {
              "type": "log",
              "log": 10
            }
          },
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 40
      },
      "id": 11
