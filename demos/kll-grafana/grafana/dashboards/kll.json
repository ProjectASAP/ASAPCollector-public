{
  "uid": "asap-kll",
  "title": "ASAP KLL tumbling and rolling estimates",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Latest tumbling KLL estimates",
      "datasource": {
        "type": "prometheus",
        "uid": "asap-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "request_duration_estimate{quantile=~\"0.5|0.99\"}",
          "legendFormat": "quantile {{quantile}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 3
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Tumbling KLL estimates over time",
      "datasource": {
        "type": "prometheus",
        "uid": "asap-prometheus"
      },
